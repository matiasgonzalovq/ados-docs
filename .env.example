# Configuración de Firebase (ADOS Docs)
# Copia este archivo a `.env.local` y rellena los valores de TU PROPIO proyecto.
# Este archivo solo declara nombres: nunca contiene valores reales.
#
# Cómo obtenerlos (BYO Firebase):
#   1. Crea un proyecto en https://console.firebase.google.com
#   2. Habilita Authentication > Correo y contraseña
#   3. Crea Cloud Firestore (p. ej. región Santiago)
#   4. Añade una app web y copia su `firebaseConfig` desde Ajustes del proyecto
#
# Ejemplos de formato (no son valores reales):
#   VITE_FIREBASE_AUTH_DOMAIN=<tu-proyecto>.firebaseapp.com
#   VITE_FIREBASE_PROJECT_ID=<tu-proyecto>
#   VITE_FIREBASE_STORAGE_BUCKET=<tu-proyecto>.appspot.com
#   VITE_FIREBASE_MESSAGING_SENDER_ID=<solo-digitos>
#   VITE_FIREBASE_APP_ID=1:<solo-digitos>:web:<alfanumerico>
#
# Obligatorias: API_KEY, AUTH_DOMAIN, PROJECT_ID, APP_ID
# Opcionales:   STORAGE_BUCKET, MESSAGING_SENDER_ID

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# ---------------------------------------------------------------------
# Opcional: emuladores locales de Firebase (sin cuenta ni proyecto real).
# Si están definidos, la app usa los emuladores y NO hace peticiones a
# Internet. `npm run test:regression` los define por ti.
# ---------------------------------------------------------------------
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8086
